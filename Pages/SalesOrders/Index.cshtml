@page
@model JSWMI_CRM.Pages.SalesOrders.IndexModel
@{
    ViewData["Title"] = "Sales Orders";
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
        <i class="bi bi-check-circle-fill me-2 fs-5"></i>
        <div>@Model.SuccessMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
        <div>@Model.ErrorMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-primary"><i class="bi bi-receipt"></i> Customer Sales Orders</h2>
        <p class="text-muted mb-0">Sales orders synced from SAP B1 or created in CRM to associate cutting plans.</p>
    </div>
    <div class="d-flex gap-2 mt-2 mt-md-0">
        <form method="post" asp-page-handler="SyncFromSap">
            <button type="submit" class="btn btn-outline-primary">
                <i class="bi bi-arrow-repeat me-1"></i> Sync from SAP B1
            </button>
        </form>
        <button type="button" class="btn btn-jsw" data-bs-toggle="modal" data-bs-target="#newOrderModal">
            <i class="bi bi-plus-lg me-1"></i> Create Sales Order
        </button>
    </div>
</div>

<div class="jsw-card">
    <div class="jsw-card-header bg-light">
        <form method="get" class="row g-2 w-100">
            <div class="col-12 col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by DocNum, Customer..." />
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <div class="col-auto">
                    <a asp-page="/SalesOrders/Index" class="btn btn-outline-secondary">Clear Filter</a>
                </div>
            }
        </form>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Order No (DocNum)</th>
                    <th>Customer Name</th>
                    <th>Customer Code</th>
                    <th>Order Date</th>
                    <th>Delivery Due Date</th>
                    <th>Order Value</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.SalesOrders.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">No sales orders found matching your search.</td>
                    </tr>
                }
                @foreach (var order in Model.SalesOrders)
                {
                    <tr>
                        <td>
                            <a asp-page="/SalesOrders/Details" asp-route-id="@order.Id" class="fw-bold text-decoration-none text-primary">
                                @order.DocNum
                            </a>
                            @if (order.DocEntry.HasValue)
                            {
                                <span class="badge bg-light text-dark border ms-1" title="SAP B1 DocEntry">SAP #@order.DocEntry</span>
                            }
                        </td>
                        <td>
                            <span class="fw-semibold">@order.CardName</span>
                        </td>
                        <td><code>@order.CardCode</code></td>
                        <td>@order.DocDate.ToString("dd-MMM-yyyy")</td>
                        <td>
                            <span class="@(order.DocDueDate < DateTime.Today ? "text-danger fw-bold" : "")">
                                @order.DocDueDate.ToString("dd-MMM-yyyy")
                            </span>
                        </td>
                        <td>₹ @order.DocTotal.ToString("N2")</td>
                        <td>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                @order.Status
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-1">
                                <a asp-page="/CuttingPlans/Create" asp-route-salesOrderId="@order.Id" class="btn btn-jsw btn-sm" title="Create Cutting Plan for this order">
                                    <i class="bi bi-scissors me-1"></i> Plan Cuts
                                </a>
                                <a asp-page="/SalesOrders/Details" asp-route-id="@order.Id" class="btn btn-outline-secondary btn-sm" title="View Order">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Create Sales Order -->
<div class="modal fade" id="newOrderModal" tabindex="-1" aria-labelledby="newOrderModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="newOrderModalLabel"><i class="bi bi-file-earmark-plus me-2"></i> Create Sales Order</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Order Number (DocNum) *</label>
                            <input type="text" asp-for="NewOrder.DocNum" class="form-control" value="SO-2026-@(new Random().Next(1000, 9999))" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Customer Code *</label>
                            <input type="text" asp-for="NewOrder.CardCode" class="form-control" placeholder="e.g. C00520" required />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Customer / Business Partner Name *</label>
                            <input type="text" asp-for="NewOrder.CardName" class="form-control" placeholder="e.g. Hyundai Motor India Ltd" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Order Date</label>
                            <input type="date" asp-for="NewOrder.DocDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Delivery Due Date</label>
                            <input type="date" asp-for="NewOrder.DocDueDate" class="form-control" value="@DateTime.Today.AddDays(10).ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Estimated Order Total (₹)</label>
                            <input type="number" step="0.01" asp-for="NewOrder.DocTotal" class="form-control" placeholder="1500000" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Status</label>
                            <select asp-for="NewOrder.Status" class="form-select">
                                <option value="Open">Open</option>
                                <option value="Planned">Planned</option>
                                <option value="Closed">Closed</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Customer Remarks / Coil Specs</label>
                            <textarea asp-for="NewOrder.Remarks" class="form-control" rows="3" placeholder="Specifications, edge requirements, delivery instructions..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Sales Order</button>
                </div>
            </form>
        </div>
    </div>
</div>
